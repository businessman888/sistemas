# Caminho absoluto para a raiz do vault do Obsidian
OBSIDIAN_VAULT_PATH=C:/Documentos/Obsidian Vault

# Subpasta dentro do vault onde os vídeos serão salvos
OBSIDIAN_YOUTUBE_FOLDER=YouTube

# Idioma preferido para a transcrição (com fallback automático)
DEFAULT_TRANSCRIPT_LANGUAGE=pt

# Conexão de grafo — vídeos relacionados
RELATED_VIDEOS_COUNT=5          # quantos vídeos relacionados linkar por nota
RELATED_MIN_SIMILARITY=0.10     # similaridade mínima para criar uma conexão (0.0–1.0)

# Tags de tópico
TOPIC_TAGS_COUNT=5              # quantas keywords extrair por vídeo

# Porta do servidor
PORT=8000

# APIs do Apify e Anthropic
APIFY_API_KEY=sua_chave_apify_aqui
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui
DATABASE_PATH=data/oyto_os.db

# Anthropic Settings
ANTHROPIC_MODEL_DEFAULT=claude-sonnet-4-6
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5

# Defaults de inferência
LLM_MAX_TOKENS_DEFAULT=2048
LLM_TEMPERATURE_DEFAULT=0.7
LLM_REQUEST_TIMEOUT_SECONDS=60

# Segundo Cérebro — RAG
BRAIN_RETRIEVAL_TOP_K=5
BRAIN_RETRIEVAL_MIN_SIMILARITY=0.05
BRAIN_CHAT_HISTORY_WINDOW=10
