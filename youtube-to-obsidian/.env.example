# Caminho absoluto para a raiz do vault do Obsidian
OBSIDIAN_VAULT_PATH=C:/Documentos/Obsidian Vault

# Subpasta dentro do vault onde os vídeos serão salvos
OBSIDIAN_YOUTUBE_FOLDER=YouTube

# Idioma preferido para a transcrição (com fallback automático)
DEFAULT_TRANSCRIPT_LANGUAGE=pt

# Porta do servidor
PORT=8000
